<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.6</version>
  </parent>
  <groupId>com.interviewprep</groupId><artifactId>study-services</artifactId><version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties><java.version>17</java.version><maven.compiler.release>17</maven.compiler.release></properties>
  <modules><module>catalog-service</module><module>progress-service</module></modules>
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
      <executions><execution><id>java17</id><goals><goal>enforce</goal></goals>
        <configuration><rules>
          <requireJavaVersion><version>[17,18)</version><message>Run Maven with JAVA_HOME pointing to JDK 17.</message></requireJavaVersion>
          <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
        </rules></configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
</project>
